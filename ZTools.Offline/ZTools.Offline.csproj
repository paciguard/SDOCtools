<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DefineConstants>$(DefineConstants);CFL_PORTABLE</DefineConstants>
    <NoWarn>$(NoWarn);CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NPOI" Version="2.7.5" />
    <PackageReference Include="ACadSharp" Version="3.8.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <Compile Include="..\ZTools.Standalone\Core\Vb.cs;..\ZTools.Standalone\Core\TemplateResources.cs;..\ZTools.Standalone\Core\SubmissionEngine.cs;..\ZTools.Standalone\Core\SectionSelection.cs;..\ZTools.Standalone\Core\Generated\*.cs;..\ZTools.Standalone\CadAdapter.cs;..\ZTools.Standalone\DrawingOutput.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Referrings\Ztools\TEMPLATE\GA.dwg;..\Referrings\Ztools\TEMPLATE\PID.dwg;..\Referrings\Ztools\TEMPLATE\SEC.dwg;..\Referrings\Ztools\ZTools.xls" LogicalName="ZTools.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\NotoSansSC-Regular.ttf" LogicalName="ZTools.Fonts.NotoSansSC.ttf" />
  </ItemGroup>
</Project>
